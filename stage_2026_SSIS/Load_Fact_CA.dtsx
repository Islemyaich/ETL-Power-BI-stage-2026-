                  description="Source OLE DB"
                  name="Source OLE DB"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="Nombre de secondes avant l'expiration d'une commande.  Une valeur égale à 0 indique un délai d'expiration infini."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="Commande SQL à exécuter."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select
clfacture.NumDoss,
clfacture.NumSer,
chambre.NumCha,
clfacture.DatOpe,
service.CodFam,
TypAdm.cod as cod_typadm,
motif.cod as cod_motif,
Medecin.CodMed,
specialite.CodSpec,
societe.NumSoc,
client.Nation,
bloc.CodBloc,
Facture_FC_FE_AV.coddep,
sum(montant *(1-clfacture.remise)) as montant
from clfacture 
left outer join Facture_FC_FE_AV on
Facture_FC_FE_AV.numaffiche=[clfacture].numbon
and Facture_FC_FE_AV.numdoss=[clfacture].numdoss
left outer join prmBloc on Facture_FC_FE_AV.coddep =prmbloc.salle
left outer join Bloc on prmbloc.bloc=bloc.codbloc
left outer join Depot on depot.coddep =Facture_FC_FE_AV.coddep
left outer join service on service.NumSer=clfacture.NumSer
left outer join client on client.numdoss=ClFacture.numdoss
left outer join chambre on chambre.NumCha=ClFacture.numcha
left outer join fampres on fampres.CodFam=service.CodFam
left outer join TypAdm on TypAdm.cod=Chambre.NumSer
left outer join motif on motif.Cod=client.TypAdm
left outer join medecin on Medecin.CodMed=Client.MedTrait
left outer join Specialite on medecin.CodSpe=Specialite.CodSpec
lEFT OUTER JOIN societe on societe.numsoc=client.numsoc
left outer join dbo.Nationnalite on client.nation=Nationnalite.codnat
where natser='C' 
group by
clfacture.numdoss,
clfacture.numser,
chambre.numcha,
clfacture.datope,
service.CodFam,
TypAdm.cod,
motif.cod,
Medecin.CodMed,
specialite.CodSpec,
societe.numsoc,
client.nation,
bloc.codbloc,
Facture_FC_FE_AV.coddep</property>
                    <property
                      dataType="System.String"
                      description="Variable contenant la commande SQL à exécuter."
                      name="SqlCommandVariable"></property>
